DATABASE_URL=postgresql://your_user:your_password@your_host:5432/your_database?sslmode=require
SECRET_KEY=change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_APP_NAME=RAG

CHAT_MODEL=openrouter/free
CHAT_MODEL_FALLBACK=meta-llama/llama-3.3-70b-instruct:free
CHAT_TEMPERATURE=0.0
CHAT_MAX_TOKENS=1024
CHAT_TIMEOUT_SECONDS=60
CHAT_NUM_GPU=0

EMBEDDING_MODEL=liquid/lfm-2.5-embedding-350m:free
EMBEDDING_DIM=1024
EMBEDDING_MAX_TOKENS=512
EMBEDDING_BATCH_SIZE=16
CHUNK_SIZE_CHARS=1400
CHUNK_OVERLAP_CHARS=200
CHUNK_MIN_CHARS=80

DENSE_TOP_K=20
SPARSE_TOP_K=20
RRF_K=60
FUSED_TOP_K=10
FINAL_TOP_K=4

ENABLE_RERANKER=true
ENABLE_METADATA_EXTRACTION=true
ENABLE_HALLUCINATION_CHECK=true
MAX_GENERATION_RETRIES=1

AGENT_MAX_TOOL_LOOPS=6
MEMORY_WINDOW_MESSAGES=10

KNOWLEDGE_DOCS_DIR=documents
