# ============================================================
# Smart Event Management - backend environment
# Copy to .env and fill in. NEVER commit .env.
# ============================================================
# --- Database (shared with the rest of the team) ---
# For a group project, use one shared cloud PostgreSQL database.
# Replace the values below with your actual Neon/Supabase/Render database URL.
DATABASE_URL=postgresql://your_user:your_password@your_host:5432/your_database?sslmode=require
SECRET_KEY=change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ============================================================
# AI / Agent / RAG
# ============================================================

# --- OpenRouter ---
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_APP_NAME=RAG

# Chat model.
# `openrouter/free` routes to a RANDOM free model on each request. It filters
# for tool-calling support, but the model changing between calls makes agent
# behaviour inconsistent. Fine while developing; pin a specific slug before a
# demo or evaluation.
CHAT_MODEL=openrouter/free
CHAT_MODEL_FALLBACK=meta-llama/llama-3.3-70b-instruct:free
CHAT_TEMPERATURE=0.0
CHAT_MAX_TOKENS=1024
CHAT_TIMEOUT_SECONDS=60
CHAT_NUM_GPU=0

# Embeddings.
# liquid/lfm-2.5-embedding-350m:free -> 1024 dims, 512-token input limit.
# EMBEDDING_DIM must match the vector(n) column in migration a1b2c3d4e5f6.
# Changing the model means a new migration AND a full reingest (--force).
EMBEDDING_MODEL=liquid/lfm-2.5-embedding-350m:free
EMBEDDING_DIM=1024
EMBEDDING_MAX_TOKENS=512
EMBEDDING_BATCH_SIZE=16

# --- Chunking (sized to stay under the 512-token embedding limit) ---
CHUNK_SIZE_CHARS=1400
CHUNK_OVERLAP_CHARS=200
CHUNK_MIN_CHARS=80

# --- Hybrid retrieval ---
DENSE_TOP_K=20
SPARSE_TOP_K=20
RRF_K=60
FUSED_TOP_K=10
FINAL_TOP_K=4

ENABLE_RERANKER=true
ENABLE_METADATA_EXTRACTION=true
ENABLE_HALLUCINATION_CHECK=true
MAX_GENERATION_RETRIES=1

# --- Agent ---
AGENT_MAX_TOOL_LOOPS=6
MEMORY_WINDOW_MESSAGES=10

KNOWLEDGE_DOCS_DIR=documents
