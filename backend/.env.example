APP_ENV=production
# --- Database (Neon / Supabase / Render PostgreSQL) ---
DATABASE_URL=postgresql://your_user:your_password@your_host:5432/your_database?sslmode=require
SECRET_KEY=GENERATE_A_STRONG_RANDOM_KEY_HERE
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- CORS ---
# Comma-separated list of allowed frontend origins.
# Example for production: CORS_ORIGINS=https://app.example.com,https://admin.example.com
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- API Docs ---
# Set to false in production to hide /docs and /redoc endpoints
ENABLE_API_DOCS=false

# --- Misc ---
EVENT_DEFAULT_DURATION_HOURS=3

# ============================================================
# Redis Cache
# ============================================================
REDIS_URL=redis://localhost:6379/0
ENABLE_REDIS_CACHE=true
REDIS_CACHE_TTL_SECONDS=300

# ============================================================
# AI / Agent / RAG
# ============================================================

# Legacy embedding key; needed while the active index is legacy and for rollback.
HUGGINGFACE_API_KEY=
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Required: select the chat model in the environment; there is no code default.
OPENROUTER_MODEL=openai/gpt-oss-120b
# Tried in order when the primary OpenRouter model fails.
OPENROUTER_FALLBACK_MODELS=google/gemma-4-26b-a4b-it:free,nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free

# Provider timeout (5-300 seconds) and retry policy.
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=1
CHAT_TEMPERATURE=0.0
# Legacy-index embedding timeout.
CHAT_TIMEOUT_SECONDS=60

# Legacy index settings; the existing knowledge_chunks.embedding column is vector(384).
# Required model ID for the active legacy index.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384

# OpenRouter embeddings use a separate model from chat. This model outputs 2048 dimensions.
# Required model ID for the staged OpenRouter index.
OPENROUTER_EMBEDDING_MODEL=nvidia/llama-nemotron-embed-vl-1b-v2:free
OPENROUTER_EMBEDDING_DIM=2048
# Keep legacy until the staged index is fully re-embedded and retrieval-tested.
RAG_ACTIVE_EMBEDDING_INDEX=legacy
EMBEDDING_MAX_TOKENS=512
EMBEDDING_BATCH_SIZE=16

# --- Chunking ---
CHUNK_SIZE_CHARS=1400
CHUNK_OVERLAP_CHARS=200
CHUNK_MIN_CHARS=80

# --- Hybrid retrieval ---
DENSE_TOP_K=20
SPARSE_TOP_K=20
RRF_K=60
FUSED_TOP_K=10
FINAL_TOP_K=4

ENABLE_RERANKER=true
ENABLE_METADATA_EXTRACTION=true
ENABLE_HALLUCINATION_CHECK=true
MAX_GENERATION_RETRIES=1

# --- Agent ---
AGENT_MAX_TOOL_LOOPS=6
MEMORY_WINDOW_MESSAGES=10

KNOWLEDGE_DOCS_DIR=documents
